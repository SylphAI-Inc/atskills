{
  "name": "atskills",
  "version": "0.1.0",
  "description": "Reference implementation of the @skills protocol — use, save, and auto-trigger agent skills like a browser, not a package manager.",
  "license": "MIT",
  "bin": {
    "atskills": "bin/atskills.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "bin/",
    "dist/",
    "PROTOCOL.md",
    "SKILLS.md",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "test": "node --test tests/",
    "test:e2e": "bash tests/e2e-skills-ui.sh && bash tests/e2e-skills-ui-real.sh && bash tests/e2e-real-repos.sh",
    "test:all": "npm run build && npm test && npm run test:e2e"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SylphAI-Inc/atskills.git"
  },
  "keywords": [
    "agent",
    "skills",
    "skill.md",
    "protocol",
    "llm"
  ],
  "dependencies": {
    "ignore": "^7.0.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
